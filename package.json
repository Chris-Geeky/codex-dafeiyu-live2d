{
  "name": "codex-dafeiyu-live2d",
  "version": "0.5.3",
  "private": true,
  "description": "DS 鲸鱼娘 Live2D adapter for the official Codex pet window",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/unit.test.mjs tests/policies.test.mjs tests/lifecycle.test.mjs",
    "verify": "node cli.mjs verify",
    "start": "node launch.mjs start --wait-for-exit --open-pet --watch-codex",
    "restore": "node launch.mjs restore",
    "test:browser": "node tests/browser.mjs",
    "test:preview": "node tests/preview.mjs",
    "test:restore": "node tests/restoration.mjs",
    "build:vendor": "node scripts/build-vendor.mjs",
    "build:branding": "node scripts/build-branding.mjs",
    "build:portable": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/Build-Portable.ps1"
  }
}
